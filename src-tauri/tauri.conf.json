{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../out"
  },
  "package": {
    "productName": "Nodal",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "fs": {
        "scope": ["$APPDATA/nodal/**", "$DOCUMENT/**", "$RESOURCE/**"],
        "readFile": true,
        "writeFile": true,
        "exists": true,
        "createDir": true
      },
      "dialog": { "open": true, "save": true },
      "path": { "all": true },
      "sql": { "all": true }
    },
    "bundle": {
      "active": true,
      "category": "GraphicsAndDesign",
      "identifier": "com.nodal.app",
      "targets": "all"
    },
    "security": { "csp": "default-src 'self'; img-src 'self' data: https: asset:; connect-src 'self' http://localhost:* https://api.openai.com https://*.openai.com" },
    "windows": [{ "title": "NODAL — Creative intelligence, connected.", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 700 }]
  }
}
